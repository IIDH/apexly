# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API). Proyecto distinto al de Flowcheck.

# Frontend (Vite los expone al navegador: solo claves públicas)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# API Node (funciones /api en Vercel). Puede ser la misma clave publishable:
# la API reenvía el JWT del usuario, así que RLS sigue aplicando.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Solo servidor (Vercel). Necesaria para "Eliminar mi cuenta". Nunca en el código.
SUPABASE_SERVICE_ROLE_KEY=

# Anti-bots en registro/login (Cloudflare Turnstile). Opcional: si está vacío no se muestra.
VITE_TURNSTILE_SITE_KEY=
